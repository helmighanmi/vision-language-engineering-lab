# Docker Python runtime.
#
# Supported by vision-language-engineering-lab v0.2.0:
# 3.11, 3.12, 3.13
#
# The default Docker baseline is Python 3.12.
PYTHON_VERSION=3.12

# Optional Hugging Face authentication token.
#
# Do not commit real credentials.
HF_TOKEN=

# Set to 1 only after all required model files are available locally.
HF_HUB_OFFLINE=0